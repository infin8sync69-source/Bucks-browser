{
  "//": "Type-checks the design system's and the framework-free chrome's JavaScript (JSDoc types): npm run check runs tsc -p design/jsconfig.json.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "$lib/*": ["../ui/src/lib/*"] }
  },
  "include": ["components/**/*.js", "runtime/**/*.js", "dist/tokens.d.ts", "../chrome/src/**/*.js", "../ui/src/app.d.ts"]
}
