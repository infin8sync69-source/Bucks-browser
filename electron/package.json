{
  "name": "bucks-browser",
  "version": "1.0.0",
  "description": "Bucks Web3 Browser",
  "main": "main.js",
  "author": "Bucks Developer",
  "scripts": {
    "start": "npx electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:shell": "cd next-shell && npm run build",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "preview": "electron-builder --dir"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/unixfs": "^7.0.4",
    "@libp2p/bootstrap": "^12.0.25",
    "@libp2p/identify": "^4.0.10",
    "@libp2p/mdns": "^12.0.25",
    "@libp2p/mplex": "^12.0.11",
    "@libp2p/tcp": "^11.0.10",
    "@libp2p/websockets": "^10.1.3",
    "@multiformats/multiaddr": "^13.0.1",
    "blockstore-fs": "^3.0.2",
    "datastore-fs": "^11.0.2",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.1.7",
    "helia": "^6.0.20",
    "leaflet": "^1.9.4",
    "libp2p": "^3.1.3",
    "node-llama-cpp": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.bucks.browser",
    "productName": "Bucks",
    "publish": [
      {
        "provider": "github",
        "owner": "infin8sync69-source",
        "repo": "Bucks-browser"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bucks"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "*.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../agent",
        "to": "agent",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.log",
          "!data/**",
          "!memory/**",
          "!examples/**",
          "!.pytest_cache/**"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "fsevents@2.3.3": true,
    "node-datachannel@0.29.0": true,
    "node-llama-cpp@3.19.0": true
  }
}
